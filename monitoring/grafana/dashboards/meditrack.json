{
 "uid": "patient-app",
 "title": "MediTrack - App & Blue/Green",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Patient records (from PostgreSQL)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(patients_total)",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Blue pods running",
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(up{job=\"patient-app\",slot=\"blue\"} == 1) or vector(0)",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Green pods running",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(up{job=\"patient-app\",slot=\"green\"} == 1) or vector(0)",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Live app instances up",
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(up{job=\"patient-app\"} == 1) or vector(0)",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Requests per second (by slot)",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (slot) (rate(http_requests_total[1m]))",
     "legendFormat": "{{slot}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "p95 latency",
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, slot) (rate(http_request_duration_seconds_bucket[1m])))",
     "legendFormat": "{{slot}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Node CPU % (EC2)",
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100",
     "legendFormat": "cpu"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Node memory used %",
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100",
     "legendFormat": "memory"
    }
   ]
  }
 ],
 "tags": [
  "devsecops"
 ]
}